{
  "version": 1,
  "kind": "sibu-eval-suite",
  "id": "skill-authoring",
  "name": "Skill authoring checks",
  "description": "Checks generated eval-authoring skills for required boundaries.",
  "modelOptions": [
    { "id": "gpt-5-mini", "label": "GPT-5 mini" },
    { "id": "gpt-5", "label": "GPT-5" }
  ],
  "testCases": [
    {
      "id": "missing-skill-boundary",
      "input": { "fixture": "fixtures/missing-skill-boundary.txt" },
      "expected": "expected/missing-skill-boundary.txt",
      "assertions": [
        { "type": "contains", "value": "hard stop" }
      ]
    },
    {
      "id": "names-artifact",
      "input": { "prompt": "safe short test prompt" },
      "assertions": [
        { "type": "llm-rubric", "rubric": "Names one artifact." }
      ]
    }
  ]
}
