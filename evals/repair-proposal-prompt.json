  },
  "run": {
    "adapter": "local-evals-workbench draft repair proposal LLM adapter",
    "modelVariable": "SIBU_EVALS_MODEL",
    "inputFixture": "fixtures/repair-proposal-prompt/unsafe-target-refusal.json"
  },
  "modelOptions": [
